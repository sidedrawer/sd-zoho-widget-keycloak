{
  "realm": "sidedrawer-dev",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,

  "accessTokenLifespan": 1800,
  "revokeRefreshToken": false,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,

  "clients": [
    {
      "clientId": "zoho-widget",
      "name": "SideDrawer Zoho Widget (Keycloak)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "https://127.0.0.1:5011/app/widget.html*",
        "https://localhost:5011/app/widget.html*",
        "https://sidedrawer.github.io/SideDrawer-keycloak/app/widget.html*"
      ],
      "webOrigins": [
        "https://127.0.0.1:5011",
        "https://localhost:5011",
        "https://sidedrawer.github.io"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "sidedrawer-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sidedrawer-api-local",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "dev@sidedrawer.test",
      "email": "dev@sidedrawer.test",
      "firstName": "Dev",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "dev", "temporary": false }
      ],
      "realmRoles": ["default-roles-sidedrawer-dev"]
    }
  ]
}
